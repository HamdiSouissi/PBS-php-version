{
    "name": "pvs/prime-business-suite",
    "description": "Prime Business Suite - ERP modulaire en PHP natif (Prime Vision Solutions)",
    "type": "project",
    "license": "proprietary",
    "keywords": ["erp", "paie", "comptabilite", "facturation", "rh", "php-natif"],
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "ext-pgsql": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "ext-zip": "*",
        "ext-dom": "*",
        "ext-xml": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-bcmath": "*",
        "ext-fileinfo": "*",
        "setasign/fpdf": "^1.8",
        "phpmailer/phpmailer": "^6.9",
        "phpoffice/phpword": "^1.3",
        "phpoffice/phpspreadsheet": "^2.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "modules/",
            "Database\\": "database/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {}
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist",
        "migrate": "php bin/console migrate:run",
        "seed": "php bin/console db:seed",
        "serve": "php -S 0.0.0.0:8080 -t public"
    }
}
