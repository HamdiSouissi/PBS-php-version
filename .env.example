# =============================================================================
# Prime Business Suite - Exemple de configuration (à copier en .env)
# Le fichier .env ne doit JAMAIS être versionné.
# =============================================================================

# ---- Application -----------------------------------------------------------
APP_NAME="Prime Business Suite"
APP_ENV=development                 # development | production
APP_DEBUG=true                      # false en production
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Paris
APP_LOCALE=fr
APP_KEY=                            # générer : php bin/console app:key-generate

# ---- Base de données MySQL / MariaDB --------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=pbs
DB_USERNAME=pbs
DB_PASSWORD=changez_moi
# Mot de passe root (compose Docker uniquement ; ignoré par Laragon/install native)
DB_ROOT_PASSWORD=changez_moi_root

# ---- Sessions / sécurité ---------------------------------------------------
SESSION_NAME=pbs_session
SESSION_LIFETIME=7200
REMEMBER_LIFETIME=2592000
JWT_SECRET=                         # générer : php bin/console app:key-generate
JWT_TTL=3600
JWT_REFRESH_TTL=1209600

# ---- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# ---- Cache / queue (file par défaut, redis facultatif) --------------------
CACHE_DRIVER=file                   # file | redis
QUEUE_DRIVER=file                   # file | redis
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Email (PHPMailer / SMTP) ---------------------------------------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=                        # tls | ssl | vide
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@prime-vision-solutions.fr
MAIL_FROM_NAME="Prime Business Suite"

# ---- IA : Ollama (local, facultatif) --------------------------------------
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=60
OLLAMA_TEMPERATURE=0.7

# ---- IA : CodeCraftAPI (externe, facultatif) ------------------------------
CODECRAFT_ENABLED=false
CODECRAFT_URL=https://codecraftapi.com/v1
CODECRAFT_API_KEY=
CODECRAFT_MODEL=

# ---- OCR (Tesseract) -------------------------------------------------------
OCR_ENABLED=false
TESSERACT_PATH=tesseract

# ---- Sauvegardes -----------------------------------------------------------
BACKUP_PATH=storage/backups
BACKUP_RETENTION_DAYS=30
